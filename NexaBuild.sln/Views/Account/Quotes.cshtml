@model List<NexaBuild.Entities.QuoteRequest>
@{
    ViewData["Title"] = "Teklif Taleplerim";
}

<!-- Page Header Start -->
<div class="page-header">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2>Teklif Taleplerim</h2>
            </div>
            <div class="col-12">
                <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                <a asp-controller="Account" asp-action="Quotes">Tekliflerim</a>
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->

<!-- Panel Content -->
<div class="contact py-5" style="background: #f8f9fa;">
    <div class="container py-4">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <partial name="_UserNav" />
            </div>

            <!-- Quotes Content -->
            <div class="col-lg-9">
                <div class="p-4 p-md-5 bg-white rounded shadow-sm" style="border: 1px solid #e9ecef;">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                        <h3 class="font-weight-bold mb-0" style="color: #030f27;">Gönderdiğiniz Teklif Talepleri</h3>
                        <a asp-controller="Quote" asp-action="Index" class="btn" style="background: #fdbe33; color: #030f27; font-weight: 700;">
                            <i class="fa fa-plus mr-1"></i> Yeni Teklif İste
                        </a>
                    </div>

                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-file-invoice fa-3x text-muted mb-3"></i>
                            <h5 class="mt-2 font-weight-bold">Henüz bir teklif talebiniz bulunmuyor.</h5>
                            <p class="text-muted small">İnşaat, arsa geliştirme veya mimari tasarım projeleriniz için hemen teklif oluşturabilirsiniz.</p>
                            <a asp-controller="Quote" asp-action="Index" class="btn" style="background: #030f27; color: #ffffff;">Teklif Formunu Doldur</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Tarih</th>
                                        <th>Proje Türü</th>
                                        <th>Tahmini Bütçe</th>
                                        <th>Durum</th>
                                        <th>Yönetici Notu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var q in Model)
                                    {
                                        <tr>
                                            <td class="small text-muted">@q.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td class="font-weight-bold text-dark">@q.ProjectType</td>
                                            <td class="small">@(q.EstimatedBudget ?? "Belirtilmedi")</td>
                                            <td>
                                                @if (q.Status == QuoteStatus.New)
                                                {
                                                    <span class="badge badge-warning text-dark">Yeni / İnceleniyor</span>
                                                }
                                                else if (q.Status == QuoteStatus.Reviewing)
                                                {
                                                    <span class="badge badge-info text-white">Mühendislik İncelemesinde</span>
                                                }
                                                else if (q.Status == QuoteStatus.Contacted)
                                                {
                                                    <span class="badge badge-primary">İletişime Geçildi</span>
                                                }
                                                else if (q.Status == QuoteStatus.Completed)
                                                {
                                                    <span class="badge badge-success">Teklif Sunuldu</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">İptal / Reddedildi</span>
                                                }
                                            </td>
                                            <td class="small text-muted">
                                                @(string.IsNullOrEmpty(q.AdminNote) ? "Henüz not eklenmedi." : q.AdminNote)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
