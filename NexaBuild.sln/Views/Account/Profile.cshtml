@model NexaBuild.DTOs.ProfileUpdateDto
@{
    ViewData["Title"] = "Profil Bilgilerim";
}

<!-- Page Header Start -->
<div class="page-header">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2>Müşteri Paneli</h2>
            </div>
            <div class="col-12">
                <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                <a asp-controller="Account" asp-action="Profile">Profilim</a>
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->

<!-- Panel Content -->
<div class="contact py-5" style="background: #f8f9fa;">
    <div class="container py-4">
        <div class="row">
            <!-- User Nav Sidebar -->
            <div class="col-lg-3">
                <partial name="_UserNav" />
            </div>

            <!-- Profile Form Content -->
            <div class="col-lg-9">
                <div class="p-4 p-md-5 bg-white rounded shadow-sm" style="border: 1px solid #e9ecef;">
                    <h3 class="mb-4 border-bottom pb-3 font-weight-bold" style="color: #030f27;">Kişisel Bilgiler & Güvenlik</h3>

                    <form asp-controller="Account" asp-action="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 font-weight-bold"></div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="FullName" class="font-weight-bold text-dark small">Adınız Soyadınız *</label>
                                <input asp-for="FullName" class="form-control" required />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="Email" class="font-weight-bold text-dark small">E-Posta Adresi</label>
                                <input asp-for="Email" class="form-control" readonly />
                                <small class="text-muted">E-posta adresi değiştirilemez.</small>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="PhoneNumber" class="font-weight-bold text-dark small">Telefon Numarası</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+90 (5XX) XXX XX XX" />
                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="AvatarFile" class="font-weight-bold text-dark small">Profil Fotoğrafı</label>
                                <input asp-for="AvatarFile" type="file" class="form-control-file border p-1 rounded" />
                            </div>
                        </div>

                        <h4 class="mt-5 mb-3 border-bottom pb-2 font-weight-bold" style="color: #030f27;">Şifre Değiştir (İsteğe Bağlı)</h4>
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label asp-for="CurrentPassword" class="font-weight-bold text-dark small">Mevcut Şifre</label>
                                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="NewPassword" class="font-weight-bold text-dark small">Yeni Şifre</label>
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="En az 6 karakter" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="ConfirmNewPassword" class="font-weight-bold text-dark small">Yeni Şifre Tekrar</label>
                                <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="pt-3">
                            <button type="submit" class="btn" style="background: #fdbe33; color: #030f27; font-weight: 700; padding: 12px 30px;">
                                <i class="fa fa-save mr-2"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
