@model NexaBuild.Entities.QuoteRequest
@{
    ViewData["Title"] = "Teklif Talebi Detayı #" + Model.Id;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fs-4 fw-bold text-white mb-1">Teklif Talebi İnceleme</h4>
        <p class="text-secondary small mb-0">Talep No: #@Model.Id &bull; @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
    </div>
    <a asp-area="Admin" asp-controller="QuoteRequests" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Taleplere Dön
    </a>
</div>

<div class="row g-4">
    <!-- Customer & Project Info -->
    <div class="col-lg-7">
        <div class="admin-card mb-4">
            <h5 class="fs-6 fw-bold text-white mb-3 border-bottom border-secondary border-opacity-25 pb-2">Müşteri ve Talep Bilgileri</h5>
            
            <div class="row g-3">
                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Ad Soyad</span>
                    <span class="fw-bold text-white fs-6">@Model.FullName</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-secondary small d-block">E-Posta</span>
                    <a href="mailto:@Model.Email" class="text-light">@Model.Email</a>
                </div>
                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Telefon</span>
                    <a href="tel:@Model.Phone" class="text-light">@Model.Phone</a>
                </div>
                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Kullanıcı Hesabı</span>
                    <span class="text-light">@(Model.User != null ? Model.User.Email : "Misafir Kullanıcı")</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Proje Türü</span>
                    <span class="badge bg-dark border border-secondary text-light">@Model.ProjectType</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-secondary small d-block">Tahmini Bütçe</span>
                    <span class="text-warning fw-semibold">@(Model.EstimatedBudget ?? "Belirtilmedi")</span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                <span class="text-secondary small d-block mb-1">Müşteri Notu / Talep Açıklaması:</span>
                <div class="p-3 bg-dark bg-opacity-50 rounded text-light" style="line-height: 1.7;">
                    @Model.Message
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
            {
                <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <span class="text-secondary small d-block mb-2">Eklenen Dosya / Proje Dokümanı:</span>
                    <a href="@Model.AttachmentPath" target="_blank" class="btn btn-outline-info btn-sm">
                        <i class="bi bi-file-earmark-arrow-down me-1"></i> Ek Dosyayı İndir / Görüntüle
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Status & Admin Action Form -->
    <div class="col-lg-5">
        <div class="admin-card">
            <h5 class="fs-6 fw-bold text-white mb-3 border-bottom border-secondary border-opacity-25 pb-2">Durum ve Not Güncelle</h5>

            <form asp-area="Admin" asp-controller="QuoteRequests" asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Talep Durumu</label>
                    <select name="status" class="form-select">
                        <option value="New" selected="@(Model.Status == QuoteStatus.New ? "selected" : null)">Yeni / Beklemede</option>
                        <option value="Reviewing" selected="@(Model.Status == QuoteStatus.Reviewing ? "selected" : null)">Mühendislik İncelemesinde</option>
                        <option value="Contacted" selected="@(Model.Status == QuoteStatus.Contacted ? "selected" : null)">Müşteriyle İletişime Geçildi</option>
                        <option value="Completed" selected="@(Model.Status == QuoteStatus.Completed ? "selected" : null)">Teklif Sunuldu & Tamamlandı</option>
                        <option value="Rejected" selected="@(Model.Status == QuoteStatus.Rejected ? "selected" : null)">İptal / Reddedildi</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Yönetici Notu (Müşteri Panelinde de Görünür)</label>
                    <textarea name="adminNote" rows="4" class="form-control" placeholder="Örn: Statik proje incelendi, bütçe teklifi e-posta ile iletildi.">@Model.AdminNote</textarea>
                </div>

                <button type="submit" class="btn btn-nb-primary w-100 py-2">
                    <i class="bi bi-save me-1"></i> Durumu Güncelle
                </button>
            </form>
        </div>
    </div>
</div>
