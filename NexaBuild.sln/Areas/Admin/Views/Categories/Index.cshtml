@model List<NexaBuild.Entities.ProjectCategory>
@{
    ViewData["Title"] = "Proje Kategorileri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fs-4 fw-bold text-white mb-1">Proje Kategorileri</h4>
        <p class="text-secondary small mb-0">Mimari ve inşaat projelerinizi sınıflandırın.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Add Form -->
    <div class="col-lg-4">
        <div class="admin-card">
            <h5 class="fs-6 fw-bold text-white mb-3"><i class="bi bi-plus-lg me-1 text-gold" style="color: var(--nb-gold-500);"></i> Yeni Kategori Ekle</h5>
            <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Kategori Adı <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control" placeholder="Örn: Butik Villa Projeleri" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Açıklama</label>
                    <textarea name="description" rows="3" class="form-control" placeholder="Kısa açıklama..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Sıralama Önceliği</label>
                    <input type="number" name="displayOrder" value="0" class="form-control" />
                </div>
                <button type="submit" class="btn btn-nb-primary w-100 py-2">
                    <i class="bi bi-check-lg me-1"></i> Kategoriyi Kaydet
                </button>
            </form>
        </div>
    </div>

    <!-- List Table -->
    <div class="col-lg-8">
        <div class="admin-card">
            <h5 class="fs-6 fw-bold text-white mb-3">Mevcut Kategoriler</h5>
            <div class="table-responsive">
                <table class="table table-dark-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Kategori Adı</th>
                            <th>Slug (URL)</th>
                            <th>Proje Sayısı</th>
                            <th>Sıra</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="fw-bold text-white">@c.Name</td>
                                <td class="small text-secondary">/projeler?category=@c.Slug</td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-light">@c.Projects.Count Proje</span>
                                </td>
                                <td>@c.DisplayOrder</td>
                                <td class="text-end">
                                    <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
