@model List<NexaBuild.Entities.BlogPost>
@{
    ViewData["Title"] = "Blog Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fs-4 fw-bold text-white mb-1">Blog & Mimarlık Yazıları</h4>
        <p class="text-secondary small mb-0">Haber ve mimari makalelerinizi yönetin.</p>
    </div>
    <a asp-area="Admin" asp-controller="Blog" asp-action="Create" class="btn btn-nb-primary py-2 px-3 fs-6">
        <i class="bi bi-plus-lg me-1"></i> Yeni Yazı Ekle
    </a>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table table-dark-custom align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;">Kapak</th>
                    <th>Yazı Başlığı</th>
                    <th>Kategori</th>
                    <th>Yazar</th>
                    <th>Okunma</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model)
                {
                    <tr>
                        <td>
                            <img src="@post.CoverImageUrl" alt="@post.Title" class="rounded" style="width: 60px; height: 40px; object-fit: cover;" />
                        </td>
                        <td>
                            <div class="fw-bold text-white">@post.Title</div>
                            <small class="text-secondary">@post.PublishedAt?.ToString("dd MMM yyyy")</small>
                        </td>
                        <td>
                            <span class="badge bg-dark border border-secondary text-light">@post.Category?.Name</span>
                        </td>
                        <td class="small text-light">@post.Author</td>
                        <td class="small text-secondary"><i class="bi bi-eye me-1"></i>@post.ViewCount</td>
                        <td>
                            @if (post.IsPublished)
                            {
                                <span class="badge bg-success">Yayında</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Taslak</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-area="Admin" asp-controller="Blog" asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-light" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-area="Admin" asp-controller="Blog" asp-action="Delete" asp-route-id="@post.Id" method="post" class="d-inline" onsubmit="return confirm('Bu blog yazısını silmek istediğinizden emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
