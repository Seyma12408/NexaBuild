@model NexaBuild.DTOs.BlogPostDto
@{
    ViewData["Title"] = "Blog Yazısını Düzenle: " + Model.Title;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fs-4 fw-bold text-white mb-1">Blog Yazısını Düzenle</h4>
        <p class="text-secondary small mb-0">@Model.Title makalesini güncelleyin.</p>
    </div>
    <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Listeye Dön
    </a>
</div>

<div class="admin-card">
    <form asp-area="Admin" asp-controller="Blog" asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CoverImageUrl" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3 mb-4">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label small fw-semibold">Yazı Başlığı <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control py-2" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label small fw-semibold">Kategori <span class="text-danger">*</span></label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select py-2"></select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Summary" class="form-label small fw-semibold">Özet <span class="text-danger">*</span></label>
                <textarea asp-for="Summary" rows="2" class="form-control"></textarea>
                <span asp-validation-for="Summary" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Content" class="form-label small fw-semibold">Makale İçeriği <span class="text-danger">*</span></label>
                <textarea asp-for="Content" rows="10" class="form-control"></textarea>
                <span asp-validation-for="Content" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CoverImageFile" class="form-label small fw-semibold">Kapak Görselini Değiştir</label>
                <input asp-for="CoverImageFile" type="file" class="form-control py-2" />
                @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                {
                    <div class="mt-2">
                        <img src="@Model.CoverImageUrl" alt="Kapak" class="rounded" style="height: 60px;" />
                    </div>
                }
            </div>

            <div class="col-md-3">
                <label asp-for="Author" class="form-label small fw-semibold">Yazar Adı</label>
                <input asp-for="Author" class="form-control py-2" />
            </div>

            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input asp-for="IsPublished" class="form-check-input" />
                    <label asp-for="IsPublished" class="form-check-label text-light">Yayında</label>
                </div>
            </div>
        </div>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <button type="submit" class="btn btn-nb-primary px-4 py-2">
                <i class="bi bi-save me-1"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </form>
</div>
