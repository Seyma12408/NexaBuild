@model List<NexaBuild.Entities.Testimonial>
@{
    ViewData["Title"] = "Müşteri Yorumları & Onay";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fs-4 fw-bold text-white mb-1">Müşteri Yorumları & Referanslar</h4>
        <p class="text-secondary small mb-0">Web sitesinde yayınlanacak referans yorumlarını onaylayın veya düzenleyin.</p>
    </div>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table table-dark-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Müşteri Adı</th>
                    <th>Ünvan / Firma</th>
                    <th>Puan</th>
                    <th>Yorum Metni</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="small text-secondary">@t.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@(t.AvatarUrl ?? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80")" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                    <span class="fw-bold text-white">@t.FullName</span>
                                </div>
                            </td>
                            <td class="small text-light">@(t.Position ?? "-") @(!string.IsNullOrEmpty(t.Company) ? $"({t.Company})" : "")</td>
                            <td>
                                <span class="text-warning">
                                    @for (int i = 0; i < t.Rating; i++) { <span>★</span> }
                                </span>
                            </td>
                            <td class="small text-secondary text-truncate" style="max-width: 300px;">“@t.Comment”</td>
                            <td>
                                @if (t.Status == ReviewStatus.Approved)
                                {
                                    <span class="badge bg-success">Yayında</span>
                                }
                                else if (t.Status == ReviewStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Reddedildi</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    @if (t.Status != ReviewStatus.Approved)
                                    {
                                        <form asp-area="Admin" asp-controller="Testimonials" asp-action="Approve" asp-route-id="@t.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success" title="Onayla & Yayınla">
                                                <i class="bi bi-check-lg"></i> Onayla
                                            </button>
                                        </form>
                                    }
                                    @if (t.Status != ReviewStatus.Rejected)
                                    {
                                        <form asp-area="Admin" asp-controller="Testimonials" asp-action="Reject" asp-route-id="@t.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-warning text-dark" title="Reddet">
                                                <i class="bi bi-x-lg"></i> Reddet
                                            </button>
                                        </form>
                                    }
                                    <form asp-area="Admin" asp-controller="Testimonials" asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" onsubmit="return confirm('Bu yorumu silmek istediğinizden emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Kayıtlı yorum bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
