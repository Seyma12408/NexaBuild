@model List<NexaBuild.Entities.ContactMessage>
@{
    ViewData["Title"] = "Gelen Mesajlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fs-4 fw-bold text-white mb-1">İletişim Mesajları</h4>
        <p class="text-secondary small mb-0">Web sitesi iletişim formundan gönderilen müşteri mesajları.</p>
    </div>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table table-dark-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Gönderen</th>
                    <th>Konu</th>
                    <th>Mesaj İçeriği</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var m in Model)
                    {
                        <tr class="@(m.Status == MessageStatus.New ? "bg-dark bg-opacity-75" : "")">
                            <td class="small text-secondary">@m.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <div class="fw-bold text-white">@m.FullName</div>
                                <small class="text-secondary">@m.Email &bull; @(m.Phone ?? "-")</small>
                            </td>
                            <td class="fw-semibold text-warning">@m.Subject</td>
                            <td class="small text-secondary text-truncate" style="max-width: 350px;">@m.Message</td>
                            <td>
                                @if (m.Status == MessageStatus.New)
                                {
                                    <span class="badge bg-danger">Yeni</span>
                                }
                                else if (m.Status == MessageStatus.Read)
                                {
                                    <span class="badge bg-secondary">Okundu</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Yanıtlandı</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    @if (m.Status == MessageStatus.New)
                                    {
                                        <form asp-area="Admin" asp-controller="Messages" asp-action="MarkAsRead" asp-route-id="@m.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Okundu İşaretle">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-area="Admin" asp-controller="Messages" asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline" onsubmit="return confirm('Bu mesajı silmek istediğinizden emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Gelen mesaj bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
