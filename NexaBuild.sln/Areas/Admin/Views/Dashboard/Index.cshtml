@model NexaBuild.DTOs.AdminDashboardDto
@{
    ViewData["Title"] = "Yönetim Paneli & Genel Bakış";
}

<!-- Stat Metric Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="admin-stat-card">
            <div>
                <div class="text-secondary small text-uppercase fw-bold mb-1">Toplam Projeler</div>
                <h3 class="fs-2 fw-bold mb-0 text-white font-heading">@Model.TotalProjects</h3>
                <small class="text-success"><i class="bi bi-arrow-up-right me-1"></i>@Model.OngoingProjects Aktif Şantiye</small>
            </div>
            <div class="admin-stat-icon bg-primary bg-opacity-25 text-primary">
                <i class="bi bi-buildings"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="admin-stat-card">
            <div>
                <div class="text-secondary small text-uppercase fw-bold mb-1">Teklif Talepleri</div>
                <h3 class="fs-2 fw-bold mb-0 text-white font-heading">@Model.TotalQuotes</h3>
                <small class="text-warning"><i class="bi bi-clock-history me-1"></i>@Model.PendingQuotes Yeni Bekleyen</small>
            </div>
            <div class="admin-stat-icon bg-warning bg-opacity-25 text-warning">
                <i class="bi bi-file-earmark-ruled"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="admin-stat-card">
            <div>
                <div class="text-secondary small text-uppercase fw-bold mb-1">Gelen Mesajlar</div>
                <h3 class="fs-2 fw-bold mb-0 text-white font-heading">@Model.RecentMessages.Count</h3>
                <small class="text-danger"><i class="bi bi-envelope-exclamation me-1"></i>@Model.UnreadMessages Okunmamış</small>
            </div>
            <div class="admin-stat-icon bg-danger bg-opacity-25 text-danger">
                <i class="bi bi-envelope"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="admin-stat-card">
            <div>
                <div class="text-secondary small text-uppercase fw-bold mb-1">Kayıtlı Kullanıcı</div>
                <h3 class="fs-2 fw-bold mb-0 text-white font-heading">@Model.TotalUsers</h3>
                <small class="text-info"><i class="bi bi-chat-quote me-1"></i>@Model.PendingReviews Bekleyen Yorum</small>
            </div>
            <div class="admin-stat-icon bg-info bg-opacity-25 text-info">
                <i class="bi bi-people"></i>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="admin-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="card-title mb-0 fs-6 fw-bold text-uppercase text-secondary">Aylık Proje Teklif Talepleri Trendi</h5>
                <span class="badge bg-dark border border-secondary text-secondary">Son 6 Ay</span>
            </div>
            <div style="height: 280px;">
                <canvas id="quotesChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="admin-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="card-title mb-0 fs-6 fw-bold text-uppercase text-secondary">Proje Durum Dağılımı</h5>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="projectStatusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Tables Row -->
<div class="row g-4">
    <!-- Recent Quotes Table -->
    <div class="col-lg-7">
        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fs-6 fw-bold text-uppercase text-secondary mb-0">Son Gelen Teklif Talepleri</h5>
                <a asp-area="Admin" asp-controller="QuoteRequests" asp-action="Index" class="small text-decoration-none" style="color: var(--nb-gold-500);">Tümünü Gör</a>
            </div>

            <div class="table-responsive">
                <table class="table table-dark-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Müşteri</th>
                            <th>Proje Türü</th>
                            <th>Durum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentQuotes.Any())
                        {
                            @foreach (var q in Model.RecentQuotes)
                            {
                                <tr>
                                    <td class="small text-secondary">@q.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <div class="fw-semibold text-white">@q.FullName</div>
                                        <small class="text-secondary" style="font-size: 0.75rem;">@q.Phone</small>
                                    </td>
                                    <td class="small text-light">@q.ProjectType</td>
                                    <td>
                                        @if (q.Status == QuoteStatus.New)
                                        {
                                            <span class="badge bg-warning text-dark">Yeni</span>
                                        }
                                        else if (q.Status == QuoteStatus.Reviewing)
                                        {
                                            <span class="badge bg-info text-dark">İnceleniyor</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@q.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-area="Admin" asp-controller="QuoteRequests" asp-action="Detail" asp-route-id="@q.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">Henüz teklif talebi yok.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Messages -->
    <div class="col-lg-5">
        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fs-6 fw-bold text-uppercase text-secondary mb-0">Son İletişim Mesajları</h5>
                <a asp-area="Admin" asp-controller="Messages" asp-action="Index" class="small text-decoration-none" style="color: var(--nb-gold-500);">Tümünü Gör</a>
            </div>

            <div class="list-group list-group-flush">
                @if (Model.RecentMessages.Any())
                {
                    @foreach (var m in Model.RecentMessages)
                    {
                        <div class="list-group-item bg-transparent text-white px-0 py-2 border-secondary border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small text-light">@m.FullName</span>
                                <span class="small text-secondary" style="font-size: 0.75rem;">@m.CreatedAt.ToString("dd.MM HH:mm")</span>
                            </div>
                            <div class="small text-truncate" style="color: var(--nb-gold-500);">@m.Subject</div>
                            <p class="small text-secondary mb-0 text-truncate">@m.Message</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small py-3 mb-0 text-center">Gelen mesaj yok.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Quotes Monthly Chart
        const quotesCtx = document.getElementById('quotesChart').getContext('2d');
        new Chart(quotesCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels)),
                datasets: [{
                    label: 'Teklif Talebi Adedi',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyQuotesData)),
                    borderColor: '#C5A880',
                    backgroundColor: 'rgba(197, 168, 128, 0.15)',
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#C5A880',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#8E95A0' } },
                    y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#8E95A0' } }
                }
            }
        });

        // Status Distribution Chart
        const statusCtx = document.getElementById('projectStatusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Planlama', 'Devam Eden', 'Tamamlanan', 'Duraklatıldı'],
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectStatusDistribution)),
                    backgroundColor: ['#6B7280', '#EAB308', '#22C55E', '#EF4444'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#94A3B8', boxWidth: 12, padding: 12 }
                    }
                }
            }
        });
    </script>
}
