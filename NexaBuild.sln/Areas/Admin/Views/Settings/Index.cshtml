@model NexaBuild.Entities.SiteSetting
@{
    ViewData["Title"] = "Genel Site Ayarları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fs-4 fw-bold text-white mb-1">Genel Site & Firma Ayarları</h4>
        <p class="text-secondary small mb-0">İletişim bilgileri, hero başlıkları, harita ve sayaç istatistikleri.</p>
    </div>
</div>

<div class="admin-card">
    <form asp-area="Admin" asp-controller="Settings" asp-action="Index" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="row g-4 mb-4">
            <!-- Kurumsal Bilgiler -->
            <div class="col-12 border-bottom border-secondary border-opacity-25 pb-2">
                <h5 class="fs-6 text-warning text-uppercase fw-bold"><i class="bi bi-buildings me-2"></i> Kurumsal & İletişim Bilgileri</h5>
            </div>

            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label small fw-semibold">Şirket / Marka Adı</label>
                <input asp-for="CompanyName" class="form-control py-2" />
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label small fw-semibold">Kurumsal E-Posta</label>
                <input asp-for="Email" class="form-control py-2" />
            </div>

            <div class="col-md-6">
                <label asp-for="Phone" class="form-label small fw-semibold">İletişim / Çağrı Merkezi Telefonu</label>
                <input asp-for="Phone" class="form-control py-2" />
            </div>

            <div class="col-md-6">
                <label asp-for="WorkingHours" class="form-label small fw-semibold">Çalışma Saatleri</label>
                <input asp-for="WorkingHours" class="form-control py-2" />
            </div>

            <div class="col-12">
                <label asp-for="Address" class="form-label small fw-semibold">Genel Merkez Adresi</label>
                <input asp-for="Address" class="form-control py-2" />
            </div>

            <div class="col-12">
                <label asp-for="MapEmbedUrl" class="form-label small fw-semibold">Google Harita Embed URL (iframe src)</label>
                <input asp-for="MapEmbedUrl" class="form-control py-2" />
            </div>

            <!-- Hero & SEO Metinleri -->
            <div class="col-12 border-bottom border-secondary border-opacity-25 pb-2 pt-3">
                <h5 class="fs-6 text-warning text-uppercase fw-bold"><i class="bi bi-display me-2"></i> Ana Sayfa Hero & SEO</h5>
            </div>

            <div class="col-md-6">
                <label asp-for="HeroTitle" class="form-label small fw-semibold">Hero Ana Başlık</label>
                <input asp-for="HeroTitle" class="form-control py-2" />
            </div>

            <div class="col-md-6">
                <label asp-for="MetaDescription" class="form-label small fw-semibold">SEO Meta Açıklaması</label>
                <input asp-for="MetaDescription" class="form-control py-2" />
            </div>

            <div class="col-12">
                <label asp-for="HeroSubtitle" class="form-label small fw-semibold">Hero Alt Açıklama Metni</label>
                <textarea asp-for="HeroSubtitle" rows="2" class="form-control"></textarea>
            </div>

            <!-- Sayaç İstatistikleri -->
            <div class="col-12 border-bottom border-secondary border-opacity-25 pb-2 pt-3">
                <h5 class="fs-6 text-warning text-uppercase fw-bold"><i class="bi bi-bar-chart-line me-2"></i> Ana Sayfa Sayaç İstatistikleri</h5>
            </div>

            <div class="col-md-3">
                <label asp-for="StatsProjectsCompleted" class="form-label small fw-semibold">Tamamlanan Proje Sayısı</label>
                <input asp-for="StatsProjectsCompleted" type="number" class="form-control py-2" />
            </div>

            <div class="col-md-3">
                <label asp-for="StatsYearsExperience" class="form-label small fw-semibold">Tecrübe Yılı</label>
                <input asp-for="StatsYearsExperience" type="number" class="form-control py-2" />
            </div>

            <div class="col-md-3">
                <label asp-for="StatsExpertEngineers" class="form-label small fw-semibold">Uzman Mühendis Sayısı</label>
                <input asp-for="StatsExpertEngineers" type="number" class="form-control py-2" />
            </div>

            <div class="col-md-3">
                <label asp-for="StatsSatisfiedClients" class="form-label small fw-semibold">Memnun Müşteri Sayısı</label>
                <input asp-for="StatsSatisfiedClients" type="number" class="form-control py-2" />
            </div>

            <!-- Sosyal Medya -->
            <div class="col-12 border-bottom border-secondary border-opacity-25 pb-2 pt-3">
                <h5 class="fs-6 text-warning text-uppercase fw-bold"><i class="bi bi-share me-2"></i> Sosyal Medya Hesapları</h5>
            </div>

            <div class="col-md-3">
                <label asp-for="InstagramUrl" class="form-label small fw-semibold">Instagram URL</label>
                <input asp-for="InstagramUrl" class="form-control py-2" placeholder="https://instagram.com/..." />
            </div>

            <div class="col-md-3">
                <label asp-for="LinkedInUrl" class="form-label small fw-semibold">LinkedIn URL</label>
                <input asp-for="LinkedInUrl" class="form-control py-2" placeholder="https://linkedin.com/..." />
            </div>

            <div class="col-md-3">
                <label asp-for="FacebookUrl" class="form-label small fw-semibold">Facebook URL</label>
                <input asp-for="FacebookUrl" class="form-control py-2" placeholder="https://facebook.com/..." />
            </div>

            <div class="col-md-3">
                <label asp-for="YouTubeUrl" class="form-label small fw-semibold">YouTube URL</label>
                <input asp-for="YouTubeUrl" class="form-control py-2" placeholder="https://youtube.com/..." />
            </div>
        </div>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <button type="submit" class="btn btn-nb-primary px-4 py-2">
                <i class="bi bi-save me-1"></i> Ayarları Güncelle
            </button>
        </div>
    </form>
</div>
